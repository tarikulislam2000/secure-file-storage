generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files     File[]

  @@map("users")
}

model File {
  id          String   @id @default(uuid())
  filename    String
  s3Key       String   @unique
  fileSize    Int
  mimeType    String
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Every dashboard query is "this owner's files, newest first", so the
  // composite index serves both the filter and the sort in one scan. It also
  // covers plain `ownerId` lookups, making a standalone index redundant.
  @@index([ownerId, createdAt(sort: Desc)])
  // `shareToken` is already `@unique`, which creates its own index — a second
  // one would only add write cost.
  @@map("files")
}
